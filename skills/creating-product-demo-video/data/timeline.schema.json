{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Demo Timeline",
  "description": "Storyboard + narration timeline produced by Claude in Phase 2 and consumed by tts_render.py and compose_video.py.",
  "type": "object",
  "required": ["source_video", "segments"],
  "properties": {
    "source_video": {
      "type": "string",
      "description": "Path to the original product screen recording."
    },
    "voice": {
      "type": "object",
      "description": "Optional global voice hints. Engine is auto-selected; these tune it where supported.",
      "properties": {
        "style": { "type": "string", "description": "e.g. 'calm, confident, Apple keynote'" },
        "elevenlabs_voice_id": { "type": "string" },
        "openai_voice": { "type": "string", "description": "e.g. 'onyx', 'nova'" },
        "say_voice": { "type": "string", "description": "macOS voice name, e.g. 'Samantha'" },
        "words_per_minute": { "type": "number", "default": 150 }
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Optional background music file." },
        "gain_db": { "type": "number", "default": -22, "description": "Music level under narration." }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_in", "source_out", "narration"],
        "properties": {
          "id": { "type": "string", "description": "Stable segment id, e.g. 's01'." },
          "source_in": { "type": "number", "description": "Start time in source video (seconds)." },
          "source_out": { "type": "number", "description": "End time in source video (seconds)." },
          "narration": { "type": "string", "description": "Apple-style line(s) Claude wrote for this beat. Empty string = silent beat." },
          "caption": { "type": "string", "description": "Optional on-screen caption burned over this segment." },
          "pace": {
            "type": "string",
            "enum": ["auto", "trim", "hold", "slow", "as_is"],
            "default": "auto",
            "description": "auto = fit segment video duration to narration duration; trim = cut to narration length; hold = freeze last frame to fill; slow = setpts slowdown to fill; as_is = keep original cut."
          },
          "max_speedup": { "type": "number", "default": 2.0, "description": "Cap when speeding footage up to match shorter narration." },
          "transition": {
            "type": "string",
            "enum": ["none", "fade", "dissolve"],
            "default": "dissolve",
            "description": "Transition into this segment."
          }
        }
      }
    }
  }
}
